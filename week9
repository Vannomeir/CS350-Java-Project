import java.util.Scanner;
import java.util.ArrayList;

public class ExpenseTracker {

 
    // ==========================================
    // INTERFACE: PAYABLE
    // ==========================================
 
    public interface Payable {
        void processPayment(double amount);
    }


    // ==========================================
    // ABSTRACT PARENT CLASS: EXPENSE
    // ==========================================

    public static abstract class Expense {

        private String name;
        private double price;
        private String category;

        // Default constructor
        public Expense() {
            this("Unnamed", 0.0, "General");
        }

        // Two-argument constructor
        public Expense(String name, double price) {
            this(name, price, "General");
        }

        // Full constructor
        public Expense(String name, double price, String category) {
            setName(name);
            setPrice(price);
            setCategory(category);
        }

        // Getters
        public String getName() {
            return name;
        }

        public double getPrice() {
            return price;
        }

        public String getCategory() {
            return category;
        }

        // Setters
        public void setName(String name) {
            if (name == null || name.trim().isEmpty()) {
                this.name = "Unnamed";
            } else {
                this.name = name.trim();
            }
        }

        public void setPrice(double price) {
            if (price < 0) {
                System.out.println("Price cannot be negative.");
                this.price = 0.0;
            } else {
                this.price = price;
            }
        }

        public void setCategory(String category) {
            if (category == null || category.trim().isEmpty()) {
                this.category = "General";
            } else {
                this.category = category.trim();
            }
        }

        // Abstract method
        public abstract String getExpenseType();

        // Concrete method
        public String describe() {
            return name + " | " + category + " | K" + price + " | Type: " + getExpenseType();
        }

        @Override
        public String toString() {
            return describe();
        }
    }


    // ==========================================
    // SUBCLASS 1: ONE-TIME EXPENSE
    // ==========================================

    public static class OneTimeExpense extends Expense {

        public OneTimeExpense(String name, double price, String category) {

            super(name, price, category);
        }

        @Override
        public String getExpenseType() {
            return "One-time";
        }
    }


    // ==========================================
    // SUBCLASS 2: RECURRING EXPENSE
    // ==========================================

    public static class RecurringExpense extends Expense {

        private String frequency;

        public RecurringExpense(String name, double price,
                                String category, String frequency) {

            super(name, price, category);

            setFrequency(frequency);
        }

        public String getFrequency() {
            return frequency;
        }

        public void setFrequency(String frequency) {

            if (frequency == null || frequency.trim().isEmpty()) {
                this.frequency = "Monthly";
            } else {
                this.frequency = frequency.trim();
            }
        }

        @Override
        public String getExpenseType() {
            return "Recurring (" + frequency + ")";
        }
    }


    // ==========================================
    // PAYMENT CLASS 1: CASH
    // ==========================================

    public static class CashPayment implements Payable {

        @Override
        public void processPayment(double amount) {
            System.out.println("Cash payment processed: K" + amount);
        }
    }


    // ==========================================
    // PAYMENT CLASS 2: MOBILE MONEY
    // ==========================================

    public static class MobileMoneyPayment implements Payable {

        @Override
        public void processPayment(double amount) {
            System.out.println("Mobile Money payment processed: K" + amount);
        }
    }


    // ==========================================
    // PAYMENT CLASS 3: CARD
    // ==========================================

    public static class CardPayment implements Payable {

        @Override
        public void processPayment(double amount) {
            System.out.println("Card payment processed: K" + amount);
        }
    }


    // ==========================================
    // BUDGET CLASS
    // ==========================================

    public static class Budget {

        private double income;
        private ArrayList<Expense> expenses;

        // Default constructor
        public Budget() {
            this(0.0);
        }

        // Parameterized constructor
        public Budget(double income) {
            setIncome(income);
            expenses = new ArrayList<>();
        }

        public double getIncome() {
            return income;
        }

        public void setIncome(double income) {

            if (income < 0) {
                System.out.println("Income cannot be negative.");
                this.income = 0.0;
            } else {
                this.income = income;
            }
        }

        // Add expense
        public void addExpense(Expense e) {

            if (e != null) {
                expenses.add(e);
            }
        }

        // Return a copy of the list
        public ArrayList<Expense> getExpenses() {
            return new ArrayList<>(expenses);
        }

        // Calculate total expenses
        public double getTotalExpenses() {

            double total = 0.0;

            for (Expense e : expenses) {
                total += e.getPrice();
            }

            return total;
        }

        // Calculate remaining balance
        public double getBalance() {
            return income - getTotalExpenses();
        }

        // Display summary
        public void printSummary() {

            System.out.println("\n----- Expense Summary -----");

            System.out.println("Income: K" + income);

            System.out.println("Total Expenses: K" + getTotalExpenses());

            System.out.println("Balance: K" + getBalance());

            System.out.println("\nIndividual Expenses:");

            if (expenses.isEmpty()) {
                System.out.println("No expenses recorded.");
            }

            // POLYMORPHISM:
            // One loop handles different expense subclasses.

            for (int i = 0; i < expenses.size(); i++) {

                Expense e = expenses.get(i);

                System.out.println(
                    "Expense " + (i + 1) + ": " + e.describe()
                );
            }
        }
    }


    // ==========================================
    // MAIN METHOD
    // ==========================================

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        Budget budget = new Budget();

        int choice;

        do {

            printMenu();

            choice = readInt(input, "Enter your choice: ");

            switch (choice) {

                case 1:

                    budget.setIncome(
                        readDouble(input, "Enter your income: ")
                    );

                    break;


                case 2:

                    System.out.println("\nChoose Expense Type:");

                    System.out.println("1. One-time Expense");
                    System.out.println("2. Recurring Expense");

                    int type = readInt(input, "Enter type: ");

                    if (type != 1 && type != 2) {
                        System.out.println("Invalid expense type.");
                        break;
                    }

                    System.out.print("Enter expense name: ");
                    String name = input.nextLine();

                    double price = readDouble(
                        input, "Enter expense price: "
                    );

                    System.out.print("Enter category: ");
                    String category = input.nextLine();

                    if (type == 1) {

                        Expense e = new OneTimeExpense(
                            name, price, category
                        );

                        budget.addExpense(e);

                        System.out.println("One-time expense added!");

                    } else {

                        System.out.print(
                            "Enter frequency (Weekly/Monthly): "
                        );

                        String frequency = input.nextLine();

                        Expense e = new RecurringExpense(
                            name, price, category, frequency
                        );

                        budget.addExpense(e);

                        System.out.println("Recurring expense added!");
                    }

                    break;


                case 3:

                    budget.printSummary();

                    break;


                case 4:

                    constructorDemo();

                    break;


                case 5:

                    paymentDemo(input);

                    break;


                case 6:

                    System.out.println(
                        "Exiting the Expense Tracker. Goodbye!"
                    );

                    break;


                default:

                    System.out.println(
                        "Invalid choice. Please try again."
                    );
            }

        } while (choice != 6);

        input.close();
    }


    // ==========================================
    // MENU
    // ==========================================

    public static void printMenu() {

        System.out.println("\n===== EXPENSE TRACKER =====");

        System.out.println("1. Enter Income");
        System.out.println("2. Add Expense");
        System.out.println("3. View Summary");
        System.out.println("4. Constructor & Polymorphism Demo");
        System.out.println("5. Payment Demonstration");
        System.out.println("6. Exit");
    }


    // ==========================================
    // CONSTRUCTOR AND POLYMORPHISM DEMO
    // ==========================================

    public static void constructorDemo() {

        System.out.println("\n--- Constructor Demonstration ---");

        Expense e1 = new OneTimeExpense(
            "Unnamed", 0.0, "General"
        );

        Expense e2 = new OneTimeExpense(
            "Airtime", 50.0, "Communication"
        );

        Expense e3 = new RecurringExpense(
            "Rent", 1500.0, "Housing", "Monthly"
        );

        System.out.println("Default-style constructor: " + e1);

        System.out.println("Two-argument-style constructor: " + e2);

        System.out.println("Recurring expense: " + e3);


        // Encapsulation demonstration

        System.out.println("\n--- Encapsulation Demo ---");

        e2.setPrice(60.0);

        System.out.println("Updated price: K" + e2.getPrice());

        e2.setPrice(-20.0);

        System.out.println("After invalid price: K" + e2.getPrice());


        // Polymorphism demonstration

        System.out.println("\n--- Polymorphism Demo ---");

        Expense[] sampleExpenses = {

            new OneTimeExpense(
                "Groceries", 250.0, "Food"
            ),

            new RecurringExpense(
                "Internet", 500.0, "Utilities", "Monthly"
            )
        };

        for (Expense e : sampleExpenses) {
            System.out.println(e.describe());
        }
    }


    // ==========================================
    // PAYMENT DEMONSTRATION
    // ==========================================

    public static void paymentDemo(Scanner input) {

        System.out.println("\n--- Payment Demonstration ---");

        System.out.println("1. Cash");
        System.out.println("2. Mobile Money");
        System.out.println("3. Card");

        int choice = readInt(input, "Choose payment method: ");

        if (choice < 1 || choice > 3) {
            System.out.println("Invalid payment method.");
            return;
        }

        double amount = readDouble(
            input, "Enter payment amount: "
        );

        if (amount < 0) {
            System.out.println("Payment cannot be negative.");
            return;
        }

        // Interface reference
        Payable payment;

        switch (choice) {

            case 1:
                payment = new CashPayment();
                break;

            case 2:
                payment = new MobileMoneyPayment();
                break;

            default:
                payment = new CardPayment();
                break;
        }

        // Dynamic method dispatch
        payment.processPayment(amount);
    }


    // ==========================================
    // INPUT VALIDATION
    // ==========================================

    public static int readInt(Scanner input, String prompt) {

        System.out.print(prompt);

        try {

            return Integer.parseInt(input.nextLine().trim());

        } catch (NumberFormatException ex) {

            return -1;
        }
    }


    public static double readDouble(Scanner input, String prompt) {

        while (true) {

            System.out.print(prompt);

            try {

                double value = Double.parseDouble(
                    input.nextLine().trim()
                );

                if (Double.isNaN(value) ||
                    Double.isInfinite(value)) {

                    System.out.println("Enter a finite number.");
                    continue;
                }

                return value;

            } catch (NumberFormatException ex) {

                System.out.println("Please enter a valid number.");
            }
        }
    }
}
